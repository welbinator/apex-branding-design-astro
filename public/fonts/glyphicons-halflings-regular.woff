<style id="wp-custom-css">
li.rmwp__new_idea_form_input:nth-child(3) {
/*     display: none; */
}
.wp-roadmap-idea p {
    color: white;
}

.idea-vote-box {
    display: none;
}
/* plyr.io stuff */
button.plyr__control.plyr__control--overlaid {
    opacity: 0;
}
.plyr__controls {
	opacity: 0;
	pointer-events: none;
}
.plyr.plyr--full-ui.plyr--video.plyr--youtube:hover .plyr__controls, .plyr.plyr--full-ui.plyr--video.plyr--youtube:hover button.plyr__control.plyr__control--overlaid {
    opacity: 1;
    pointer-events: all;
}
.plyr__video-wrapper.plyr__video-embed {
    min-height: 200px;
}
.youtubes.type-youtubes .entry-content {
    margin: 0;
}
/* end plyr.io stuff */

.section.container.youtube.archive {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
	max-width: 100%;
	gap: 20px;
	
}
.section.container.youtube.archive article {
	border-radius: 5px;
	box-shadow: 0px 0px 10px #fac56b30;
}
.section.container.youtube.archive h2 {
	font-size: clamp(1rem, 18px, 2rem); 
	text-align: center;
}
.client-logo {
/*     max-height: 100px; */
}
h1.hero-header {
/* 	font-size: 2.5em; */
}
.hero {
/* 	align-items: flex-start;
	padding-top: 20vh; */
}
.hero-container p {
/* 	font-size: 1em; */
	
}


h5.team-header.subheader {
/* 	text-align: center; */
}
h3.team-header {
/* 	text-align: center; */
}
.footer .nav .nav-item:first-child .nav-link {
/*     padding-left: 0!important; */
}

h1.hero-header {
/*     font-size: clamp(1.5rem, 3vw, 2em); */
	
} 
.hero-btn {
box-shadow: 0 0 0 0 #fff, 0.5rem 0.5rem 30px #58448e00;
  transition: box-shadow 1s;
}
.hero-btn:hover {
/*   box-shadow: 0 0 5px 2px #fff, 0.5rem 0.5rem 30px #58448e00; */
}
.hero-tagline {
/* 	margin-top: 30px; */
}
.hero-tagline p {
/* 	margin: 0; */
} 
body.blog article.post {
    box-shadow: 0px 0px 16px #ffffff10;
    padding: 20px;
}
body.blog .home a {
	color: #fac56b;
	text-decoration: none;
}
body.blog .home header.entry-header h2.entry-title a {
	color: white;
	text-decoration: none;
}
.entry-meta {
    font-size: 1rem;
}
.home article {
	display: flex;
	gap: 50px;
}
.home article .post-thumbnail-div {
	max-height: 200px;
	width: auto;
}



.slide-in-left {
	-webkit-animation: slide-in-left 1s cubic-bezier(0.250, 0.460, 0.450, 0.940) 1s both;
	        animation: slide-in-left 1s cubic-bezier(0.250, 0.460, 0.450, 0.940) 1s both;
}


/* ----------------------------------------------
 * Generated by Animista on 2021-12-9 22:4:36
 * Licensed under FreeBSD License.
 * See http://animista.net/license for more info. 
 * w: http://animista.net, t: @cssanimista
